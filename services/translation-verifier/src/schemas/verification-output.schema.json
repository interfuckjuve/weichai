{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:forexplore:verification-output:2.0",
  "title": "VerificationOutputSchema",
  "description": "Public verify()/CLI result. verifyWithReceipt() uses #/definitions/receipt. SHA-256 bindings, unique IDs, evidence references and canonical receipt metadata require host validation in addition to this schema.",
  "$comment": "The singleton allOf preserves the root result reference while allowing local schema type generation.",
  "allOf": [
    {
      "$ref": "#/definitions/result"
    }
  ],
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issue": {
      "title": "VerificationIssue",
      "type": "object",
      "required": [
        "id",
        "kind",
        "message",
        "evidenceArtifactIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "kind": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "message": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "caseId": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "sourceObservation": {
          "description": "Strategy-owned JSON source observation."
        },
        "targetObservation": {
          "description": "Strategy-owned JSON target observation."
        },
        "evidenceArtifactIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        }
      },
      "additionalProperties": true
    },
    "artifact": {
      "title": "VerificationArtifact",
      "type": "object",
      "required": [
        "id",
        "kind",
        "path",
        "contentHash",
        "mediaType"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "kind": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "path": {
          "$ref": "#/definitions/nonEmptyString",
          "description": "Safe normalized relative path within the artifact store; checked by the host."
        },
        "contentHash": {
          "$ref": "#/definitions/sha256"
        },
        "mediaType": {
          "$ref": "#/definitions/nonEmptyString"
        }
      },
      "additionalProperties": true
    },
    "strategyOutput": {
      "title": "VerificationStrategyOutput",
      "type": "object",
      "required": [
        "summary",
        "issues",
        "artifacts",
        "strategyReport",
        "mode",
        "referenceDecision",
        "referenceReason",
        "executionStatus",
        "sourceAssessment",
        "targetAssessment",
        "problems"
      ],
      "not": {
        "properties": { "status": {} },
        "required": ["status"]
      },
      "properties": {
        "summary": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/issue"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/artifact"
          }
        },
        "strategyReport": {
          "description": "Strategy-owned JSON report. The selected strategy validates its internal format."
        },
        "mode": {
          "enum": [
            "differential",
            "target_only"
          ]
        },
        "referenceDecision": {
          "enum": [
            "accepted",
            "rejected",
            "undetermined"
          ]
        },
        "referenceReason": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "executionStatus": {
          "enum": [
            "completed",
            "partial",
            "failed",
            "cancelled"
          ]
        },
        "sourceAssessment": {
          "$ref": "#/definitions/assessment"
        },
        "targetAssessment": {
          "$ref": "#/definitions/assessment"
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/problem"
          }
        }
      },
      "if": {
        "properties": {
          "targetAssessment": {
            "const": "bug_found"
          }
        },
        "required": [
          "targetAssessment"
        ]
      },
      "then": {
        "properties": {
          "issues": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "additionalProperties": true
    },
    "result": {
      "title": "VerificationResult",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/definitions/strategyOutput"
        }
      ],
      "required": [
        "schemaVersion",
        "strategyId",
        "strategyVersion",
        "subjectHash",
        "round",
        "createdAt",
        "contentHash",
        "inputHash"
      ],
      "properties": {
        "schemaVersion": {
          "const": "2.0"
        },
        "strategyId": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "strategyVersion": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "subjectHash": {
          "$ref": "#/definitions/sha256"
        },
        "round": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {},
        "issues": {},
        "artifacts": {},
        "strategyReport": {},
        "createdAt": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "contentHash": {
          "$ref": "#/definitions/sha256"
        },
        "mode": {},
        "referenceDecision": {},
        "referenceReason": {},
        "executionStatus": {},
        "sourceAssessment": {},
        "targetAssessment": {},
        "problems": {},
        "inputHash": {
          "$ref": "#/definitions/sha256",
          "description": "SHA-256 of canonical complete VerificationInput, including reference policy, independent test basis and both snapshots."
        }
      },
      "additionalProperties": false
    },
    "strategyDescriptor": {
      "title": "VerificationStrategyDescriptor",
      "type": "object",
      "required": [
        "id",
        "version",
        "displayName"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "version": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "displayName": {
          "$ref": "#/definitions/nonEmptyString"
        }
      },
      "additionalProperties": true
    },
    "resultArtifact": {
      "title": "VerificationResultArtifact",
      "type": "object",
      "required": [
        "id",
        "kind",
        "path",
        "contentHash",
        "size",
        "mediaType"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "kind": {
          "const": "verification-result"
        },
        "path": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "contentHash": {
          "$ref": "#/definitions/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "const": "application/json"
        }
      },
      "additionalProperties": true
    },
    "receipt": {
      "title": "VerificationReceipt",
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "$ref": "#/definitions/result"
        },
        "resultArtifact": {
          "$ref": "#/definitions/resultArtifact"
        }
      },
      "description": "resultArtifact may be absent only for failed execution with an artifact_persistence_failed problem, no decisive findings and no retained artifacts; the host enforces this cross-field rule and canonical-byte metadata.",
      "additionalProperties": true
    },
    "assessment": {
      "enum": [
        "bug_found",
        "no_bug_observed",
        "suspected_bug",
        "inconclusive",
        "not_checked"
      ]
    },
    "problem": {
      "title": "VerificationProblem",
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "report_missing",
            "report_invalid_json",
            "report_schema_invalid",
            "report_evidence_invalid",
            "agent_timeout",
            "command_timeout",
            "agent_error",
            "environment_unavailable",
            "insufficient_test_basis",
            "workspace_integrity_violation",
            "context_incomplete",
            "unsupported_language",
            "input_invalid",
            "artifact_persistence_failed",
            "internal_error",
            "cancelled"
          ]
        },
        "message": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "side": {
          "enum": [
            "source",
            "target"
          ]
        },
        "commandId": {
          "$ref": "#/definitions/nonEmptyString"
        }
      },
      "additionalProperties": false
    }
  }
}
