{
  "name": "@forexplore/translation-verifier",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run check:schema-types && tsc -p tsconfig.json",
    "test": "npm run check:schema-types && vitest run src",
    "test:e2e-data": "tsc -p e2e/tsconfig.json && vitest run e2e/*.test.ts && node --test e2e/fileupload-datasets.test.mjs",
    "generate:schema-types": "tsx scripts/generate-schema-types.ts",
    "check:schema-types": "tsx scripts/generate-schema-types.ts --check",
    "verify": "tsx src/verification-cli.ts",
    "e2e": "tsx e2e/run-smoke-e2e.ts",
    "e2e:single-agent": "tsx e2e/run-single-agent-e2e.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schemas/verification-input.schema.json": "./src/schemas/verification-input.schema.json",
    "./schemas/verification-output.schema.json": "./src/schemas/verification-output.schema.json",
    "./schemas/verification-run.schema.json": "./src/schemas/verification-run.schema.json"
  },
  "types": "./src/index.ts",
  "dependencies": {
    "@forexplore/contracts": "0.1.0",
    "@forexplore/workflow-core": "0.1.0",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
