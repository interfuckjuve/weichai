# Required. The Analyzer and Translator agents use this key internally.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Restricts every MCP target path to this project root.
ADAPTATION_PROJECT_ROOT=/absolute/path/to/target-csharp-project
# Server-owned .forexplore/analysis directory containing immutable snapshots.
# ADAPTATION_ANALYSIS_ROOT=/absolute/path/to/repository/.forexplore/analysis

# Optional. Enables integrated compile validation in adaptation tools.
# ADAPTATION_SKELETON_PROJECT_PATH=/absolute/path/to/target-csharp-project
