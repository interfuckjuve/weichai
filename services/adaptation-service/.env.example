ADAPTATION_HOST=127.0.0.1
ADAPTATION_PORT=8788
# The VS Code extension host does not need CORS. If a browser client is
# intentionally enabled, set one explicit origin instead of '*'.
# ADAPTATION_CORS_ORIGIN=http://127.0.0.1:5173

# Required. This key is read only by adaptation-service and is never sent to Vite.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Optional. Defaults to fixtures/target-system/commons-fileupload-java-skeleton.
# ADAPTATION_SKELETON_PROJECT_PATH=/absolute/path/to/commons-fileupload-java-skeleton

# Optional. Backfill target; defaults to ADAPTATION_SKELETON_PROJECT_PATH.
# ADAPTATION_PROJECT_ROOT=/absolute/path/to/commons-fileupload-java-skeleton

# Module-plan snapshots are server-owned. When the VS Code workspace is not
# the same directory as ADAPTATION_PROJECT_ROOT, point this at that workspace's
# .forexplore/analysis directory before requesting a module plan.
# ADAPTATION_ANALYSIS_ROOT=/absolute/path/to/workspace/.forexplore/analysis

# The HTTP service never executes retrieved candidate code on the host.  Keep
# this disabled.  A value other than "disabled" is rejected; production
# differential execution requires a separately deployed, credential-free,
# network-disabled isolated executor integration.
# ADAPTATION_VERIFIER_EXECUTION=disabled

# Optional. Java validation uses javac from JAVA_HOME or PATH.
# JAVA_HOME=/path/to/jdk
