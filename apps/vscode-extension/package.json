{
  "name": "forexplore-vscode",
  "displayName": "ForeXplore Code Translation",
  "description": "在 VSCode 中运行 ForeXplore 代码翻译工作流：检索相似实现、生成目标代码并以 diff 预览回填。",
  "version": "0.1.0",
  "publisher": "forexplore",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension/extension.js",
  "files": [
    "dist/extension/**",
    "dist/webview/**",
    "README.md"
  ],
  "activationEvents": [
    "onCommand:forexplore.startTranslation",
    "onCommand:forexplore.showPanel",
    "onCommand:forexplore.checkRepositories",
    "onCommand:forexplore.reindex",
    "onCommand:forexplore.restoreLastCheckpoint",
    "onCommand:forexplore.indexModuleMigrationRepository",
    "onCommand:forexplore.reviewModuleMigrationPlan",
    "onCommand:forexplore.reviewModuleMigrationWave",
    "onCommand:forexplore.prepareModuleMigrationWave",
    "onCommand:forexplore.approveModuleMigrationWave",
    "onCommand:forexplore.recoverModuleMigrationReview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "forexplore.startTranslation",
        "title": "ForeXplore: 开始代码翻译"
      },
      {
        "command": "forexplore.showPanel",
        "title": "ForeXplore: 打开翻译面板"
      },
      {
        "command": "forexplore.checkRepositories",
        "title": "ForeXplore: 检查检索仓库"
      },
      {
        "command": "forexplore.reindex",
        "title": "ForeXplore: 重新索引检索仓库"
      },
      {
        "command": "forexplore.restoreLastCheckpoint",
        "title": "ForeXplore: 恢复最近一次回填"
      },
      {
        "command": "forexplore.indexModuleMigrationRepository",
        "title": "ForeXplore: 索引模块迁移仓库"
      },
      {
        "command": "forexplore.reviewModuleMigrationPlan",
        "title": "ForeXplore: 审阅模块迁移计划"
      },
      {
        "command": "forexplore.reviewModuleMigrationWave",
        "title": "ForeXplore: 审阅下一迁移波次"
      },
      {
        "command": "forexplore.prepareModuleMigrationWave",
        "title": "ForeXplore: 导入并准备下一迁移波次"
      },
      {
        "command": "forexplore.approveModuleMigrationWave",
        "title": "ForeXplore: 审批并提交已准备迁移波次"
      },
      {
        "command": "forexplore.recoverModuleMigrationReview",
        "title": "ForeXplore: 恢复模块迁移审阅状态"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "forexplore.startTranslation",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "forexplore@1"
        }
      ]
    },
    "configuration": {
      "title": "ForeXplore",
      "properties": {
        "forexplore.executionMode": {
          "type": "string",
          "enum": ["real"],
          "default": "real",
          "description": "调用本地 SeekDB 检索服务和语言无关的适配服务；两个服务都必须健康。"
        },
        "forexplore.repositoryPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["E:/CS/devsys/weichai/fixtures/code-corpus"],
          "description": "仅检查本地目录是否可读，不能证明该目录已被远端检索服务索引。真实检索范围由服务端部署配置决定。"
        },
        "forexplore.retrievalApiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "检索服务地址。"
        },
        "forexplore.adaptationApiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8788",
          "description": "语言无关翻译服务地址。"
        },
        "forexplore.moduleWaveValidationCommands": {
          "type": "array",
          "scope": "machine",
          "default": [],
          "description": "仅由本地 VS Code 宿主在隔离波次 worktree 中执行的联合验证命令。未配置时模块波次准备会被阻止。",
          "items": {
            "type": "object",
            "required": ["id", "label", "executable"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "executable": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "cwd": { "type": "string" },
              "required": { "type": "boolean" },
              "timeoutMs": { "type": "number" }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:webview && npm run build:extension",
    "build:webview": "vite build",
    "build:extension": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && node esbuild.integration.mjs && tsx src/test/integration/run-tests.ts",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@forexplore/adaptation-service": "0.1.0",
    "@forexplore/adaptation-http-adapter": "0.1.0",
    "@forexplore/code-indexer": "0.1.0",
    "@forexplore/contracts": "0.1.0",
    "@forexplore/seekdb-adapter": "0.1.0",
    "@forexplore/workflow-core": "0.1.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
