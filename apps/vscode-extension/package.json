{
  "name": "forexplore-vscode",
  "displayName": "RECAST Code Intelligence",
  "description": "在 VS Code 中运行 RECAST 智能检索与代码复用工作流：定位实现、组织上下文、生成目标代码并审阅回填。",
  "version": "0.1.0",
  "publisher": "forexplore",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension/extension.js",
  "files": [
    "dist/extension/**",
    "dist/extension/node_modules/**",
    "dist/webview/**",
    "media/**",
    "README.md"
  ],
  "activationEvents": [
    "onView:forexplore.launcher",
    "onCommand:forexplore.showPanel",
    "onCommand:forexplore.checkRepositories",
    "onCommand:forexplore.reindex",
    "onCommand:forexplore.refreshCodeIntelligence",
    "onCommand:forexplore.restoreLastCheckpoint",
    "onCommand:forexplore.indexModuleMigrationRepository",
    "onCommand:forexplore.reviewModuleMigrationPlan",
    "onCommand:forexplore.reviewModuleMigrationWave",
    "onCommand:forexplore.prepareModuleMigrationWave",
    "onCommand:forexplore.approveModuleMigrationWave",
    "onCommand:forexplore.recoverModuleMigrationReview"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forexplore",
          "title": "RECAST",
          "icon": "media/forexplore.svg"
        }
      ]
    },
    "views": {
      "forexplore": [
        {
          "id": "forexplore.launcher",
          "name": "RECAST",
          "type": "tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "forexplore.launcher",
        "contents": "[打开翻译面板](command:forexplore.showPanel)"
      }
    ],
    "commands": [
      {
        "command": "forexplore.showPanel",
        "title": "RECAST: 打开智能开发工作台"
      },
      {
        "command": "forexplore.checkRepositories",
        "title": "RECAST: 检查参考工程"
      },
      {
        "command": "forexplore.reindex",
        "title": "RECAST: 重新索引参考工程"
      },
      {
        "command": "forexplore.refreshCodeIntelligence",
        "title": "RECAST: 刷新代码智能索引"
      },
      {
        "command": "forexplore.restoreLastCheckpoint",
        "title": "RECAST: 恢复最近一次回填"
      },
      {
        "command": "forexplore.indexModuleMigrationRepository",
        "title": "RECAST: 索引模块迁移仓库"
      },
      {
        "command": "forexplore.reviewModuleMigrationPlan",
        "title": "RECAST: 审阅模块迁移计划"
      },
      {
        "command": "forexplore.reviewModuleMigrationWave",
        "title": "RECAST: 审阅下一迁移波次"
      },
      {
        "command": "forexplore.prepareModuleMigrationWave",
        "title": "RECAST: 导入并准备下一迁移波次"
      },
      {
        "command": "forexplore.approveModuleMigrationWave",
        "title": "RECAST: 审批并提交已准备迁移波次"
      },
      {
        "command": "forexplore.recoverModuleMigrationReview",
        "title": "RECAST: 恢复模块迁移审阅状态"
      }
    ],
    "configuration": {
      "title": "RECAST",
      "properties": {
        "forexplore.executionMode": {
          "type": "string",
          "enum": ["real"],
          "default": "real",
          "description": "使用扩展内置的 SeekDB 模块检索和语言无关的适配服务。"
        },
        "forexplore.repositoryPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "参考工程的本地目录。保存后由扩展建立版本化结构索引、项目模块 Summary 和模块内候选索引。"
        },
        "forexplore.targetRepositoryPaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "通过目标工程选择器明确选择的目录。只有同时位于当前工作区中的目录会作为目标工程索引。"
        },
        "forexplore.topK": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 10,
          "description": "每次检索返回的候选方案数量。"
        },
        "forexplore.adaptationApiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8788",
          "description": "语言无关翻译服务地址。"
        },
        "forexplore.moduleWaveValidationCommands": {
          "type": "array",
          "scope": "machine",
          "default": [],
          "description": "仅由本地 VS Code 宿主在隔离波次 worktree 中执行的联合验证命令。未配置时模块波次准备会被阻止。",
          "items": {
            "type": "object",
            "required": ["id", "label", "executable"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "executable": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "cwd": { "type": "string" },
              "required": { "type": "boolean" },
              "timeoutMs": { "type": "number" }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:webview && npm run build:extension",
    "build:webview": "vite build",
    "build:extension": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && node esbuild.integration.mjs && tsx src/test/integration/run-tests.ts",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@forexplore/adaptation-service": "0.1.0",
    "@forexplore/adaptation-http-adapter": "0.1.0",
    "@forexplore/code-indexer": "0.1.0",
    "@forexplore/code-intelligence-service": "0.1.0",
    "@forexplore/contracts": "0.1.0",
    "@forexplore/workflow-core": "0.1.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
