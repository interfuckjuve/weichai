  "cards": [
    {
      "dot": "cyan",
      "title": "双投影与双人审",
      "items": [
        "符号索引保留在 code_symbols，走 /v1/search",
        "模块索引使用独立 docs / generations / heads，配置禁止复用符号表",
        "两个投影的匹配、加权与融合明确留给下游",
        "Gate 1 只审批模块边界，accept 后 Agent 才能生成模块摘要",
        "Gate 2 逐模块审批叙述，全部 accept 才进入 publishing-knowledge",
        "代码未强制两位不同身份；reviewed 也不等于业务行为已验证"
      ]
    },
    {
      "dot": "rose",
      "title": "发布补偿 ≠ 显式撤销",
      "items": [
        "本地不可变制品与 SQLite CAS 先激活，再推进 SeekDB active head CAS",
        "发布失败自动按 remote withdraw → local withdraw 补偿，状态可重放恢复",
        "仅 ready 可由用户携 actor / reason 发起，顺序为 remote-first",
        "随后撤销 SQLite 当前头并恢复前代；无前代则 active head 为空",
        "这是双 CAS + saga，不是分布式 ACID；历史 publication 与 receipt 不删除"
      ]
    }
  ]
